# Starship prompt for Tenebrous. Generated from palette.json, edit
# templates/starship.template in the Tenebrous repo instead.
#
# Colours come from the palette table at the bottom, so the prompt is
# Tenebrous no matter which terminal theme is running. Tenebrous is dark only.

palette = "tenebrous"

add_newline = true

# Default is 500ms. Cold starts under iCloud Drive (~/Library/Mobile Documents)
# can exceed that on the first exec in a directory, which prints a timeout
# warning into the prompt. 1s costs nothing on warm paths and stops the noise.
command_timeout = 1000

format = """
$directory\
$git_branch\
$git_status\
$nodejs$python$rust$golang$java\
$cmd_duration\
$line_break\
$character"""

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold magenta)"

[directory]
style = "bold blue0"
truncation_length = 3
truncate_to_repo = true
read_only = " 󰌾"

[git_branch]
symbol = " "
style = "magenta"
format = "on [$symbol$branch]($style) "

[git_status]
style = "amber"
format = "([$all_status$ahead_behind]($style) )"
conflicted = "="
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count}"
stashed = "$${count}"
modified = "!${count}"
staged = "+${count}"
renamed = "»${count}"
deleted = "✘${count}"

[cmd_duration]
min_time = 2_000
style = "fg-dark"
format = "took [$duration]($style) "

# ─── Language modules: shown only inside a relevant project ──────────
[nodejs]
symbol = " "
style = "green"
format = "via [$symbol($version )]($style)"
# Don't treat a stray .js file as a Node project. The Scales Obsidian vault has
# a lone publish.js at its root, which was enough to make starship run
# `node --version` on every prompt in a directory that has nothing to do with
# Node. Real projects always carry package.json or node_modules.
detect_extensions = []
detect_files = ["package.json", ".node-version", ".nvmrc"]
detect_folders = ["node_modules"]

[python]
symbol = " "
style = "teal"
format = "via [$symbol($version )]($style)"

[rust]
symbol = " "
style = "red"
format = "via [$symbol($version )]($style)"

[golang]
symbol = " "
style = "cyan"
format = "via [$symbol($version )]($style)"

[java]
symbol = " "
style = "red1"
format = "via [$symbol($version )]($style)"

[palettes.tenebrous]
blue0 = "{{blue0}}"
magenta = "{{magenta}}"
amber = "{{amber}}"
fg-dark = "{{fg-dark}}"
green = "{{green}}"
teal = "{{teal}}"
cyan = "{{cyan}}"
red = "{{red}}"
red1 = "{{red1}}"
