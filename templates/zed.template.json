{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Tenebrous",
  "author": "Sigrunixia",
  "themes": [
    {
      "name": "Tenebrous",
      "appearance": "dark",
      "style": {
        "border": "{{bg-highlight}}",
        "border.variant": "{{bg-raised}}",
        "border.focused": "{{accent}}",
        "border.selected": "{{accent}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{bg-raised}}",
        "elevated_surface.background": "{{bg-deep}}",
        "surface.background": "{{bg-deep}}",
        "background": "{{bg-deep}}",
        "element.background": "{{bg-deep}}",
        "element.hover": "{{bg-highlight}}",
        "element.active": "{{bg-highlight}}",
        "element.selected": "{{bg-highlight}}",
        "element.disabled": "{{bg-deep}}",
        "drop_target.background": "{{amber:30}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{bg-highlight}}",
        "ghost_element.active": "{{bg-highlight}}",
        "ghost_element.selected": "{{bg-highlight}}",
        "ghost_element.disabled": "{{bg-deep}}",
        "text": "{{text}}",
        "text.muted": "{{text-dim}}",
        "text.placeholder": "{{text-faint}}",
        "text.disabled": "{{text-faint}}",
        "text.accent": "{{purple}}",
        "icon": "{{text-dim}}",
        "icon.muted": "{{text-faint}}",
        "icon.disabled": "{{text-faint}}",
        "icon.placeholder": "{{text-faint}}",
        "icon.accent": "{{purple}}",
        "status_bar.background": "{{bg-deep}}",
        "title_bar.background": "{{bg-deep}}",
        "title_bar.inactive_background": "{{bg-deep}}",
        "toolbar.background": "{{bg}}",
        "tab_bar.background": "{{bg-deep}}",
        "tab.inactive_background": "{{bg-deep}}",
        "tab.active_background": "{{bg}}",
        "search.match_background": "{{yellow:40}}",
        "panel.background": "{{bg-deep}}",
        "panel.focused_border": "{{accent}}",
        "panel.indent_guide": "{{bg-highlight}}",
        "panel.indent_guide_active": "{{text-faint}}",
        "panel.indent_guide_hover": "{{text-faint}}",
        "pane.focused_border": null,
        "pane_group.border": "{{bg-highlight}}",
        "scrollbar.thumb.background": "{{bg-highlight}}",
        "scrollbar.thumb.hover_background": "{{text-faint}}",
        "scrollbar.thumb.border": "{{bg-highlight}}",
        "scrollbar.track.background": "{{bg-deep}}",
        "scrollbar.track.border": "{{bg-deep}}",
        "editor.foreground": "{{text}}",
        "editor.background": "{{bg}}",
        "editor.gutter.background": "{{bg}}",
        "editor.subheader.background": "{{bg-deep}}",
        "editor.active_line.background": "{{bg-raised}}",
        "editor.highlighted_line.background": "{{bg-raised}}",
        "editor.line_number": "{{text-faint}}",
        "editor.active_line_number": "{{green}}",
        "editor.hover_line_number": "{{text}}",
        "editor.invisible": "{{text-faint}}",
        "editor.wrap_guide": "{{bg-highlight}}",
        "editor.active_wrap_guide": "{{text-faint}}",
        "editor.indent_guide": "{{bg-highlight}}",
        "editor.indent_guide_active": "{{text-faint}}",
        "editor.document_highlight.read_background": "{{yellow:26}}",
        "editor.document_highlight.write_background": "{{orange:40}}",
        "terminal.background": "{{bg}}",
        "terminal.foreground": "{{text}}",
        "terminal.bright_foreground": "{{silver}}",
        "terminal.dim_foreground": "{{text-faint}}",
        "terminal.ansi.background": "{{bg}}",
        "terminal.ansi.black": "{{bg-highlight}}",
        "terminal.ansi.bright_black": "{{text-faint}}",
        "terminal.ansi.dim_black": "{{bg-raised}}",
        "terminal.ansi.red": "{{red}}",
        "terminal.ansi.bright_red": "{{red1}}",
        "terminal.ansi.dim_red": "{{red-dim}}",
        "terminal.ansi.green": "{{green}}",
        "terminal.ansi.bright_green": "{{lime}}",
        "terminal.ansi.dim_green": "{{green0}}",
        "terminal.ansi.yellow": "{{amber}}",
        "terminal.ansi.bright_yellow": "{{yellow}}",
        "terminal.ansi.dim_yellow": "{{amber0}}",
        "terminal.ansi.blue": "{{blue}}",
        "terminal.ansi.bright_blue": "{{cyan}}",
        "terminal.ansi.dim_blue": "{{blue-dim}}",
        "terminal.ansi.magenta": "{{purple}}",
        "terminal.ansi.bright_magenta": "{{pink}}",
        "terminal.ansi.dim_magenta": "{{purple-dim}}",
        "terminal.ansi.cyan": "{{teal}}",
        "terminal.ansi.bright_cyan": "{{cyan}}",
        "terminal.ansi.dim_cyan": "{{cyan-dim}}",
        "terminal.ansi.white": "{{text}}",
        "terminal.ansi.bright_white": "{{silver}}",
        "terminal.ansi.dim_white": "{{text-dim}}",
        "link_text.hover": "{{amber}}",
        "conflict": "{{orange}}",
        "conflict.background": "{{orange:1a}}",
        "conflict.border": "{{orange:66}}",
        "created": "{{green}}",
        "created.background": "{{green:1a}}",
        "created.border": "{{green:66}}",
        "deleted": "{{red1}}",
        "deleted.background": "{{red1:1a}}",
        "deleted.border": "{{red1:66}}",
        "error": "{{red1}}",
        "error.background": "{{red1:1a}}",
        "error.border": "{{red1:66}}",
        "hidden": "{{text-faint}}",
        "hidden.background": "{{text-faint:1a}}",
        "hidden.border": "{{text-faint:66}}",
        "hint": "{{text-faint}}",
        "hint.background": "{{text-faint:1a}}",
        "hint.border": "{{text-faint:66}}",
        "ignored": "{{text-faint}}",
        "ignored.background": "{{text-faint:1a}}",
        "ignored.border": "{{text-faint:66}}",
        "info": "{{blue}}",
        "info.background": "{{blue:1a}}",
        "info.border": "{{blue:66}}",
        "modified": "{{amber}}",
        "modified.background": "{{amber:1a}}",
        "modified.border": "{{amber:66}}",
        "predictive": "{{text-faint}}",
        "predictive.background": "{{text-faint:1a}}",
        "predictive.border": "{{text-faint:66}}",
        "renamed": "{{blue}}",
        "renamed.background": "{{blue:1a}}",
        "renamed.border": "{{blue:66}}",
        "success": "{{green}}",
        "success.background": "{{green:1a}}",
        "success.border": "{{green:66}}",
        "unreachable": "{{text-faint}}",
        "unreachable.background": "{{text-faint:1a}}",
        "unreachable.border": "{{text-faint:66}}",
        "warning": "{{orange}}",
        "warning.background": "{{orange:1a}}",
        "warning.border": "{{orange:66}}",
        "players": [
          { "cursor": "{{accent}}", "background": "{{accent}}", "selection": "{{amber:40}}" },
          { "cursor": "{{purple}}", "background": "{{purple}}", "selection": "{{purple:40}}" },
          { "cursor": "{{green}}", "background": "{{green}}", "selection": "{{green:40}}" },
          { "cursor": "{{pink}}", "background": "{{pink}}", "selection": "{{pink:40}}" },
          { "cursor": "{{cyan}}", "background": "{{cyan}}", "selection": "{{cyan:40}}" },
          { "cursor": "{{orange}}", "background": "{{orange}}", "selection": "{{orange:40}}" },
          { "cursor": "{{lime}}", "background": "{{lime}}", "selection": "{{lime:40}}" },
          { "cursor": "{{red}}", "background": "{{red}}", "selection": "{{red:40}}" }
        ],
        "syntax": {
          "attribute": { "color": "{{cyan}}" },
          "boolean": { "color": "{{red}}" },
          "comment": { "color": "{{text-dim}}", "font_style": "italic" },
          "comment.doc": { "color": "{{text-dim}}", "font_style": "italic" },
          "constant": { "color": "{{red}}" },
          "constructor": { "color": "{{blue}}" },
          "embedded": { "color": "{{text}}" },
          "emphasis": { "color": "{{amber}}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{blue}}", "font_weight": 700 },
          "enum": { "color": "{{blue}}" },
          "function": { "color": "{{amber}}" },
          "function.builtin": { "color": "{{blue}}" },
          "hint": { "color": "{{text-faint}}" },
          "keyword": { "color": "{{purple}}" },
          "label": { "color": "{{cyan}}" },
          "link_text": { "color": "{{amber0}}" },
          "link_uri": { "color": "{{amber0}}" },
          "number": { "color": "{{pink}}" },
          "operator": { "color": "{{teal}}" },
          "predictive": { "color": "{{text-faint}}", "font_style": "italic" },
          "preproc": { "color": "{{purple}}" },
          "primary": { "color": "{{text}}" },
          "property": { "color": "{{cyan}}" },
          "punctuation": { "color": "{{text-dim}}" },
          "punctuation.bracket": { "color": "{{text-dim}}" },
          "punctuation.delimiter": { "color": "{{text-dim}}" },
          "punctuation.list_marker": { "color": "{{amber0}}" },
          "punctuation.markup": { "color": "{{text-dim}}" },
          "punctuation.special": { "color": "{{teal}}" },
          "string": { "color": "{{green}}" },
          "string.escape": { "color": "{{green0}}" },
          "string.regex": { "color": "{{green0}}" },
          "string.special": { "color": "{{green0}}" },
          "string.special.symbol": { "color": "{{red}}" },
          "tag": { "color": "{{red}}" },
          "text.literal": { "color": "{{yellow}}" },
          "title": { "color": "{{blue}}", "font_weight": 700 },
          "type": { "color": "{{blue}}" },
          "variable": { "color": "{{text}}" },
          "variable.member": { "color": "{{cyan}}" },
          "variable.parameter": { "color": "{{teal}}" },
          "variable.special": { "color": "{{teal}}" },
          "variant": { "color": "{{blue}}" }
        }
      }
    }
  ]
}
