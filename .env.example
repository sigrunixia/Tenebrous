# Copy to .env and fill in. build.sh reads it on every run.
OBSIDIAN_REPO=/path/to/Tenebrous-Obsidian
ZED_REPO=/path/to/Tenebrous-Zed
# Zed themes folder, needed to deploy the Zed theme
ZED_THEMES=/path/to/zed/themes
# Needed for the Obsidian target
VAULT=/path/to/your/vault
# Obsidian CLI vault name, needed with --publish
VAULT_NAME=Your vault name
